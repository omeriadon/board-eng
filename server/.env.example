# Copy to .env (gitignored) beside compose.yaml, or put these in Dokploy's environment list.

# Required in production: the server won't start without it. One shared secret, sent by the apps and the
# board as `Authorization: Bearer <token>` on /v1 routes and the socket. Generate one with: openssl rand -hex 32
BOARD_API_TOKEN=

# Local `swift run` only. The Docker image always listens on 0.0.0.0:8080 and ignores these.
# HOST=127.0.0.1
# PORT=8080
